# Copy to .env. Never commit .env, and never put keys in ~/.cursor/mcp.json.
ANTHROPIC_API_KEY=
DATABASE_URL_WRITER=postgresql://sow_owner@localhost:5432/sow_intelligence
DATABASE_URL_READER=postgresql://sow_reader@localhost:5432/sow_intelligence
SOW_DOCUMENTS_PATH=./sanitised_sows
ALIAS_MAP_PATH=./private/alias_map.csv      # real name -> alias; stays in the sandbox
REGISTER_PATH=./register.csv                # delivery register: which SOWs are proven
EMBED_MODEL=BAAI/bge-small-en-v1.5          # runs locally
EMBED_DIMS=384
EXTRACT_MODEL=claude-haiku-5-5
CHAT_MODEL=claude-opus-5-5
